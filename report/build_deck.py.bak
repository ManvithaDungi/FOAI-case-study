# ---------------------------------------------------------------- 6 algorithms
s = slide('Variables are protocol fields, domains their allowed values, constraints each agent\'s private limits.')
header(s, '06  //  ALGORITHMS & SEARCH STRATEGY', 'Negotiation as distributed constraint satisfaction')
steps = [('1 Review', 'All agents review the same public snapshot'),
         ('2 Decide', 'APPROVE, REJECT or COUNTER_PROPOSE'),
         ('3 Order', 'IRB, Sponsor, Biostatistician, Advocate'),
