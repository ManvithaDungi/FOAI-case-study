# ---------------------------------------------------------------- 4 env + agent
s = slide('Classification follows Russell and Norvig. Mock mode is deterministic; LLM mode is stochastic.')
header(s, '04  //  ENVIRONMENT & AGENT ANALYSIS', 'Environment classification and agent category')
table(s, 0.6, 1.6, 7.0, [
    ['Property', 'Classification'],
    ['Observability', 'Partially observable (peer limits hidden)'],
    ['Agents', 'Multi-agent, mixed cooperative / competitive'],
    ['Determinism', 'Deterministic (mock); stochastic (LLM)'],
    ['Episodic?', 'Sequential: each round builds on the last'],
    ['Static / dynamic', 'Static between rounds; changes via amendments'],
    ['Discrete / continuous', 'Discrete time; integer and bounded numeric'],
    ['Known / unknown', 'Known rules, hidden peer constraints']], [2.4, 4.6], 12, 0.5)
cards = [('Sponsor', 'Goal-based + learning: infers hidden power bar from blocked cuts', 'Blocking vote', CYAN),
         ('Biostatistician', 'Goal-based, model-based: design levers first', 'Blocking vote', VIOLET),
         ('Ethics Committee', 'Goal-based, safety-critical: binding amendments', 'Veto', ORANGE),
         ('Patient Advocate', 'Goal-based: burden and access, asks for remote monitoring', 'Advisory', '2DD4BF')]
for i, (n, d, a, col) in enumerate(cards):
    y = 1.6 + i * 1.28
    box(s, 7.9, y, 4.8, 1.15, CARD, '1F2A44')
    text(s, 8.05, y + 0.05, 3.2, 0.35, n, 14, col, True, HEAD)
    text(s, 11.0, y + 0.05, 1.6, 0.35, a, 11, WHITE, True, MONO, PP_ALIGN.RIGHT)
    text(s, 8.05, y + 0.42, 4.5, 0.7, d, 12, 'E6EBF2')
text(s, 0.6, 5.8, 7.0, 0.9,
