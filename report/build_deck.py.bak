box(s, 0.6, 4.6, 3.5, 0.6, CARD, ORANGE)
text(s, 0.7, 4.65, 3.3, 0.5, 'Constraint Checker (audit)', 13, ORANGE, True, anchor=MSO_ANCHOR.MIDDLE)
box(s, 4.3, 4.6, 3.5, 0.6, CARD, '2DD4BF')
text(s, 4.4, 4.65, 3.3, 0.5, 'Consensus / Deadlock / Failure', 13, '2DD4BF', True, anchor=MSO_ANCHOR.MIDDLE)
text(s, 0.6, 5.5, 7.2, 1.5,
