    x = 0.6 + i * 1.82
    box(s, x, 2.5, 1.72, 0.9, CARD, col)
    text(s, x, 2.5, 1.72, 0.55, n, 13, col, True, HEAD, PP_ALIGN.CENTER, MSO_ANCHOR.MIDDLE)
    text(s, x, 2.95, 1.72, 0.4, 'private state', 10, MUTED, False, MONO, PP_ALIGN.CENTER)
box(s, 0.6, 3.7, 7.2, 0.6, CARD, VIOLET)
text(s, 0.7, 3.75, 7.0, 0.5, 'Negotiation Engine: reviews, proposals, objections', 13, WHITE, True,
