header(s, '02  //  INTRODUCTION', 'Four stakeholders, one protocol, hidden limits')
ag = [('Sponsor', 'Minimum cost and time', 'Private: budget ceiling, sample cap, max duration', CYAN),
      ('Biostatistician', 'Statistical validity', 'Private: power >= 80%, alpha 0.05', VIOLET),
      ('Ethics Committee', 'Participant safety (veto)', 'Private: max dosage, monitoring, AE reporting', ORANGE),
      ('Patient Advocate', 'Less burden, more access', 'Private: max visits, procedures, exclusions', '2DD4BF')]
for i, (n, o, p, col) in enumerate(ag):
    x = 0.6 + i * 3.1
    box(s, x, 1.7, 2.9, 2.3, CARD, '1F2A44')
    text(s, x + 0.15, 1.8, 2.6, 0.4, n, 17, col, True, HEAD)
    text(s, x + 0.15, 2.3, 2.6, 0.5, o, 14, WHITE, True)
    text(s, x + 0.15, 2.95, 2.6, 0.9, p, 12, MUTED)
card(s, 0.6, 4.3, 5.9, 2.6, 'Single agent',
     ['One blended, weighted objective', 'Must be given every private constraint',
      'No disagreement, no veto, no audit trail'], ORANGE, 14)
card(s, 6.8, 4.3, 5.9, 2.6, 'Our multi-agent system',
     ['Four independent reasoning processes', 'Each agent sees only its own constraints',
      'Explicit objections, IRB veto, all four must approve', 'Independent Constraint Checker audits every version'],
     CYAN, 14)

# ---------------------------------------------------------------- 3 PEAS
s = slide('System-level PEAS. Performance is measured by the independent Constraint Checker, not by the agents.')
header(s, '03  //  PEAS FORMULATION', 'PEAS, metrics and input / output mapping')
table(s, 0.6, 1.6, 12.1, [
    ['', 'Description'],
    ['Performance', 'Consensus (4 approve) | 0 constraint violations | rounds | proposals accepted vs blocked | '
                    'power >= 0.80 | cost <= budget'],
    ['Environment', 'Shared protocol + public history, public calculators (power, cost, recruitment), guarded '
                    'private state'],
    ['Actuators', 'APPROVE / REJECT / COUNTER_PROPOSE, amendments to own fields, qualitative requests, objections'],
    ['Sensors', 'Protocol version, public history, public tool report, feedback on own proposals, own constraints']],
    [1.9, 10.2], 12, 0.52)
table(s, 0.6, 4.35, 12.1, [
    ['Agent', 'Input (sensor)', 'Output (actuator)'],
    ['Sponsor', 'Protocol, power/cost report, blocked-proposal feedback, budget/sample/duration limits',
     'sample, hospitals, dose arms, budget, remote monitoring'],
    ['Biostatistician', 'Protocol, power report, power/alpha limits, locked fields',
     'sample, randomisation, endpoint, alpha'],
    ['Ethics (IRB)', 'Protocol, max dose, monitoring and AE rules', 'dosage, monitoring, AE, exclusions (veto)'],
    ['Patient Advocate', 'Protocol, max visits/procedures/exclusions',
