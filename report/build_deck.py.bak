from pptx import Presentation
from pptx.util import Inches, Pt
from pptx.dml.color import RGBColor
from pptx.enum.shapes import MSO_SHAPE
from pptx.enum.text import PP_ALIGN, MSO_ANCHOR
from pptx.chart.data import CategoryChartData
from pptx.enum.chart import XL_CHART_TYPE

BG, CARD, CYAN, VIOLET, ORANGE, MUTED, WHITE = (
    '080D18', '0D1424', '00E5FF', '8B5CF6', 'FF6B35', '98A6B8', 'FFFFFF')
HEAD, BODY, MONO = 'Space Grotesk', 'Inter', 'JetBrains Mono'
SHOT = 'clinical_trial_mas/docs/screenshots/'


def rgb(h):
    return RGBColor.from_string(h)


prs = Presentation()
prs.slide_width, prs.slide_height = Inches(13.333), Inches(7.5)
BLANK = prs.slide_layouts[6]


def slide(notes=''):
    s = prs.slides.add_slide(BLANK)
    s.background.fill.solid()
    s.background.fill.fore_color.rgb = rgb(BG)
    if notes:
        s.notes_slide.notes_text_frame.text = notes
    return s


def box(s, x, y, w, h, fill=CARD, line=None, shape=MSO_SHAPE.ROUNDED_RECTANGLE):
    sh = s.shapes.add_shape(shape, Inches(x), Inches(y), Inches(w), Inches(h))
    sh.fill.solid()
    sh.fill.fore_color.rgb = rgb(fill)
    if line:
        sh.line.color.rgb = rgb(line)
        sh.line.width = Pt(1)
    else:
        sh.line.fill.background()
    if shape == MSO_SHAPE.ROUNDED_RECTANGLE:
        sh.adjustments[0] = 0.06
    sh.shadow.inherit = False
    return sh


def text(s, x, y, w, h, t, size=14, color=WHITE, bold=False, font=BODY, align=PP_ALIGN.LEFT,
         anchor=MSO_ANCHOR.TOP):
    tb = s.shapes.add_textbox(Inches(x), Inches(y), Inches(w), Inches(h))
    tf = tb.text_frame
    tf.word_wrap = True
    tf.margin_left = tf.margin_right = Inches(0.05)
    tf.margin_top = tf.margin_bottom = Inches(0.03)
    tf.vertical_anchor = anchor
    lines = t if isinstance(t, list) else [t]
    for i, ln in enumerate(lines):
        p = tf.paragraphs[0] if i == 0 else tf.add_paragraph()
        p.alignment = align
        p.space_after = Pt(4)
        r = p.add_run()
        r.text = ln
        r.font.size = Pt(size)
        r.font.bold = bold
        r.font.name = font
        r.font.color.rgb = rgb(color)
    return tb


def header(s, tag, title):
    text(s, 0.6, 0.35, 12, 0.35, tag, 12, CYAN, True, MONO)
    text(s, 0.6, 0.7, 12.1, 0.75, title, 30, WHITE, True, HEAD)


def table(s, x, y, w, rows, colw, size=12, rowh=0.38, head=VIOLET):
    shp = s.shapes.add_table(len(rows), len(rows[0]), Inches(x), Inches(y), Inches(w),
                             Inches(rowh * len(rows)))
    tbl = shp.table
    tblPr = shp._element.graphic.graphicData.tbl.tblPr
    tblPr.set('firstRow', '0')
    tblPr.set('bandRow', '0')
    for j, cw in enumerate(colw):
        tbl.columns[j].width = Inches(cw)
    for i, r in enumerate(rows):
        tbl.rows[i].height = Inches(rowh)
        for j, v in enumerate(r):
            c = tbl.cell(i, j)
            c.fill.solid()
            c.fill.fore_color.rgb = rgb(head if i == 0 else (CARD if i % 2 else '111A2E'))
            c.margin_left = c.margin_right = Inches(0.08)
            c.margin_top = c.margin_bottom = Inches(0.03)
            c.vertical_anchor = MSO_ANCHOR.MIDDLE
            tf = c.text_frame
            tf.word_wrap = True
            p = tf.paragraphs[0]
            run = p.add_run()
            run.text = str(v)
            run.font.size = Pt(size)
            run.font.name = BODY
            run.font.bold = (i == 0) or (j == 0)
            run.font.color.rgb = rgb(WHITE if i == 0 else (CYAN if j == 0 else 'E6EBF2'))
    return tbl


def card(s, x, y, w, h, title, lines, accent=CYAN, size=12):
    box(s, x, y, w, h, CARD, '1F2A44')
    text(s, x + 0.15, y + 0.1, w - 0.3, 0.4, title, 15, accent, True, HEAD)
    text(s, x + 0.15, y + 0.55, w - 0.3, h - 0.65, lines, size, 'E6EBF2')


# ---------------------------------------------------------------- 1 title
s = slide('One-line pitch: four agents with private constraints negotiate one Phase II protocol; an independent '
          'checker audits every version. Replace the presenter line with names and roll numbers.')
text(s, 0.8, 1.3, 11, 0.4, 'FOAI 23CSE401  |  CASE STUDY REVIEW 1', 14, CYAN, True, MONO)
text(s, 0.8, 1.9, 11.5, 1.8, 'Multi-Agent Clinical Trial Protocol Negotiation', 46, WHITE, True, HEAD)
text(s, 0.8, 3.8, 11, 0.8, 'Autonomous AI agents with hidden objectives negotiating one Phase II protocol', 20,
     MUTED)
for i, (ini, col) in enumerate([('S', CYAN), ('B', VIOLET), ('E', ORANGE), ('P', '2DD4BF')]):
    c = box(s, 0.9 + i * 0.9, 4.9, 0.7, 0.7, col, None, MSO_SHAPE.OVAL)
    text(s, 0.9 + i * 0.9, 4.95, 0.7, 0.6, ini, 22, BG, True, HEAD, PP_ALIGN.CENTER, MSO_ANCHOR.MIDDLE)
text(s, 0.8, 6.0, 12, 0.4,
     'Druva Teja Korlakunta (CB.SC.U4CSE23317)  |  Manvitha Dungi (CB.SC.U4CSE23318)  |  Semester 7', 14, WHITE)
