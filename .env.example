# Copy to .env and fill in to enable LLM mode (python main.py --llm).
# Without a key the system runs in deterministic MOCK mode.
OPENAI_API_KEY=your_api_key_here
# Any OpenAI-compatible endpoint works (OpenAI, Azure-compatible proxies, Ollama, LM Studio, vLLM...)
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
